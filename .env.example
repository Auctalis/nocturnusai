# ─────────────────────────────────────────────────────────────────────────────
# AxiomBase — Logic Server for Agentic AI
# Copy to .env and edit:  cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=9300
HOST=0.0.0.0
STORAGE_DIR=/data

# ── Authentication ─────────────────────────────────────────────────────────
# Three auth modes (pick one):
#
# 1. Dev mode (default): Leave both API_KEY and AUTH_ENABLED unset → no auth
# 2. Legacy single key: Set API_KEY → all requests require X-API-Key header
# 3. Full RBAC: Set AUTH_ENABLED=true → managed API keys with roles/scoping
#
# Legacy mode (simple, single static key):
# API_KEY=your-secret-key
#
# RBAC mode (recommended for production):
AUTH_ENABLED=false
#
# Admin credentials for RBAC bootstrap (first-time setup only).
# After bootstrap, admin uses API keys for all requests.
# Change these in production!
AXIOMBASE_ADMIN_USER=admin
AXIOMBASE_ADMIN_PASS=axiombase
#
# RBAC Quick Start:
#   1. Set AUTH_ENABLED=true and start the server
#   2. POST /auth/bootstrap with admin credentials → get your first admin key
#   3. Use that admin key to create writer/reader keys for agents
#   4. See GET /auth/status to check current auth state

# ── LLM Provider ────────────────────────────────────────────────────────────
# Pick ONE provider. Auto-detected from whichever API key is set.
# Priority: Anthropic > OpenAI > Google > Ollama > Custom
#
# Provider            | Env var needed          | Default model
# ─────────────────── | ─────────────────────── | ─────────────────────
# Anthropic (Claude)  | ANTHROPIC_API_KEY       | claude-sonnet-4-20250514
# OpenAI (GPT)        | OPENAI_API_KEY          | gpt-4o-mini
# Google (Gemini)     | GOOGLE_API_KEY          | gemini-2.0-flash
# Ollama (local)      | (nothing — just run it) | llama3.2
# Groq                | LLM_API_KEY + BASE_URL  | llama-3.1-70b-versatile
# Mistral             | LLM_API_KEY + BASE_URL  | mistral-large-latest
# DeepSeek            | LLM_API_KEY + BASE_URL  | deepseek-chat
# Any OpenAI-compat   | LLM_API_KEY + BASE_URL  | (set LLM_MODEL)

# Uncomment ONE block below:

# ── Option A: Anthropic Claude (recommended) ────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ── Option B: OpenAI ────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...

# ── Option C: Google Gemini ─────────────────────────────────────────────────
# GOOGLE_API_KEY=AIza...

# ── Option D: Ollama (local, no API key needed) ─────────────────────────────
# Runs alongside AxiomBase in Docker. No cost, fully private.
# Start with:  make up-ollama
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_BASE_URL=http://ollama:11434/v1

# ── Option E: Custom OpenAI-compatible endpoint ─────────────────────────────
# LLM_PROVIDER=custom
# LLM_MODEL=your-model-name
# LLM_API_KEY=your-key
# LLM_BASE_URL=https://your-endpoint.com/v1

# ── Extraction (NL text → facts) ────────────────────────────────────────────
EXTRACTION_ENABLED=true
EXTRACTION_MAX_FACTS=50
# EXTRACTION_MODEL=                  # Override model for extraction only

# ── Encryption at Rest ──────────────────────────────────────────────────────
# 64 hex characters = 256-bit AES key. Generate with:
#   openssl rand -hex 32
# ENCRYPTION_KEY=

# ── TLS / HTTPS ─────────────────────────────────────────────────────────────
# TLS_ENABLED=false
# TLS_PORT=9443
# TLS_KEYSTORE_PATH=/data/keystore.p12
# TLS_KEYSTORE_PASSWORD=changeit
# TLS_KEY_ALIAS=axiombase
# TLS_KEY_PASSWORD=changeit

# ── Logging ─────────────────────────────────────────────────────────────────
# LOG_FORMAT=text                    # text (human-readable) or json (structured, for ELK/Datadog)
# LOG_LEVEL=INFO                     # DEBUG, INFO, WARN, ERROR
# LOG_FILE=/data/axiombase.log       # Enable file logging with rotation (50MB/file, 30 days, 1GB cap)

# ── Monitoring ─────────────────────────────────────────────────────────────
# Start with:  make up-monitoring   (adds Prometheus + Grafana)
# Grafana:     http://localhost:3000
# Prometheus:  http://localhost:9090
GRAFANA_USER=admin
GRAFANA_PASSWORD=axiombase

# ── Replication ──────────────────────────────────────────────────────────────
# REPLICATION_MODE=LEADER            # LEADER or FOLLOWER
# LEADER_URL=http://leader:9300      # Required for FOLLOWER mode
