# ─────────────────────────────────────────────────────────────────────────────
# NocturnusAI — Logic Server for Agentic AI
# Defaults for `make up` and `docker compose --env-file .env.example ...`
# Optional override:  cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=9300
HOST=0.0.0.0
STORAGE_DIR=/data

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for cross-origin requests.
# Default (unset): localhost:3000, localhost:5173, localhost:8080
# Set to "*" only for fully public, read-only APIs.
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# ── Request limits ────────────────────────────────────────────────────────────
# Maximum allowed request body size in bytes. Default: 10485760 (10 MB).
# MAX_REQUEST_BODY_BYTES=10485760

# ── Authentication ─────────────────────────────────────────────────────────
# Three auth modes (pick one):
#
# 1. Dev mode (default): Leave both API_KEY and AUTH_ENABLED unset → no auth
# 2. Legacy single key: Set API_KEY → all requests require X-API-Key header
# 3. Full RBAC: Set AUTH_ENABLED=true → managed API keys with roles/scoping
#
# Legacy mode (simple, single static key):
# API_KEY=your-secret-key
#
# RBAC mode (recommended for production):
AUTH_ENABLED=false
#
# Admin credentials for RBAC bootstrap (first-time setup only).
# After bootstrap, admin uses API keys for all requests.
# MUST be changed in production — server warns at startup if these are still defaults.
NOCTURNUSAI_ADMIN_USER=admin
NOCTURNUSAI_ADMIN_PASS=nocturnusai
#
# Default API key expiry in days. Applies to all new keys including bootstrap.
# Unset = no expiry (not recommended for production). Recommended: 365
# API_KEY_DEFAULT_EXPIRY_DAYS=365
#
# RBAC Quick Start:
#   1. Set AUTH_ENABLED=true and start the server
#   2. POST /auth/bootstrap with admin credentials → get your first admin key
#   3. Use that admin key to create writer/reader keys for agents
#   4. See GET /auth/status to check current auth state

# ── LLM Provider ────────────────────────────────────────────────────────────
# Pick ONE provider. Auto-detected from whichever API key is set.
# Priority: Anthropic > OpenAI > Google > Ollama > Custom
#
# Provider            | Env var needed          | Default model
# ─────────────────── | ─────────────────────── | ─────────────────────
# Anthropic (Claude)  | ANTHROPIC_API_KEY       | claude-sonnet-4-20250514
# OpenAI (GPT)        | OPENAI_API_KEY          | gpt-4o-mini
# Google (Gemini)     | GOOGLE_API_KEY          | gemini-2.0-flash
# Ollama (local)      | (nothing — just run it) | granite3.3:8b
# Groq                | LLM_API_KEY + BASE_URL  | llama-3.1-70b-versatile
# Mistral             | LLM_API_KEY + BASE_URL  | mistral-large-latest
# DeepSeek            | LLM_API_KEY + BASE_URL  | deepseek-chat
# Any OpenAI-compat   | LLM_API_KEY + BASE_URL  | (set LLM_MODEL)

# ── Default: Ollama (free, local, no API key needed) ─────────────────────────
# Install Ollama from https://ollama.com, then: ollama pull granite3.3:8b
# host.docker.internal resolves to your Mac/Linux host from inside the container.
# Works automatically on Docker Desktop (Mac/Windows); on Linux it requires the
# extra_hosts entry in docker-compose.yml (already present).
# For a zero-dependency start, run: docker compose --profile ollama up
LLM_PROVIDER=ollama
LLM_MODEL=granite3.3:8b
LLM_BASE_URL=http://host.docker.internal:11434/v1
EXTRACTION_ENABLED=true

# ── Switch provider: uncomment ONE block to override the Ollama default ──────

# ── Option A: Anthropic Claude (fastest cloud inference) ────────────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ── Option B: OpenAI ────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...

# ── Option C: Google Gemini ─────────────────────────────────────────────────
# LLM_PROVIDER=google
# GOOGLE_API_KEY=AIza...

# ── Option D: Custom OpenAI-compatible endpoint ─────────────────────────────
# LLM_PROVIDER=custom
# LLM_MODEL=your-model-name
# LLM_API_KEY=your-key
# LLM_BASE_URL=https://your-endpoint.com/v1

# ── Extraction (NL text → facts) ────────────────────────────────────────────
# EXTRACTION_MAX_FACTS=50
# EXTRACTION_MODEL=                  # Override model for extraction only

# ── Encryption at Rest ──────────────────────────────────────────────────────
# 64 hex characters = 256-bit AES key. Generate with:
#   openssl rand -hex 32
# ENCRYPTION_KEY=

# ── TLS / HTTPS ─────────────────────────────────────────────────────────────
# TLS_ENABLED=false
# TLS_PORT=9443
# TLS_KEYSTORE_PATH=/data/keystore.p12
# TLS_KEYSTORE_PASSWORD=changeit
# TLS_KEY_ALIAS=nocturnusai
# TLS_KEY_PASSWORD=changeit

# ── Logging ─────────────────────────────────────────────────────────────────
# LOG_FORMAT=text                    # text (human-readable) or json (structured, for ELK/Datadog)
# LOG_LEVEL=INFO                     # DEBUG, INFO, WARN, ERROR
# LOG_FILE=/data/nocturnusai.log       # Enable file logging with rotation (50MB/file, 30 days, 1GB cap)

# ── Monitoring ─────────────────────────────────────────────────────────────
# Start with:  make up-monitoring   (adds Prometheus + Grafana)
# Grafana:     http://localhost:3000
# Prometheus:  http://localhost:9090
GRAFANA_USER=admin
# Override this in .env before starting monitoring anywhere shared
GRAFANA_PASSWORD=change-me-before-use

# ── Replication ──────────────────────────────────────────────────────────────
# REPLICATION_MODE=LEADER            # LEADER or FOLLOWER
# LEADER_URL=http://leader:9300      # Required for FOLLOWER mode
