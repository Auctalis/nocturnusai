ASSERT FORALL ?p, ?a { 
    Minor(?p) <- Person(?p) AND Age(?p, ?a) AND LessThan(?a, 18) 
};

ASSERT FORALL ?c, ?p { 
    Void(?c) <- Contract(?c) AND SignedBy(?c, ?p) AND Minor(?p) 
};

ASSERT Person(JohnDoe);
ASSERT Age(JohnDoe, 16);
ASSERT Contract(LeaseAgreement_001);
ASSERT SignedBy(LeaseAgreement_001, JohnDoe);

-- Need to assert comparison fact since no built-in math yet
ASSERT LessThan(16, 18);

INFER Void(LeaseAgreement_001);

EXPLAIN Void(LeaseAgreement_001);
