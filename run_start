#!/bin/bash
set -e

# ─────────────────────────────────────────────────────────────────────────────
# NocturnusAI Launcher
# Detects docker/podman, creates .env if missing, starts the stack.
# Usage:
#   ./run_start              # server only (cloud LLM)
#   ./run_start --ollama     # server + local Ollama
# ─────────────────────────────────────────────────────────────────────────────

GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
NC='\033[0m'

OLLAMA_PROFILE=""
if [[ "$1" == "--ollama" || "$1" == "-o" ]]; then
    OLLAMA_PROFILE="--profile ollama"
fi

# ── First-time setup ────────────────────────────────────────────────────────
if [ ! -f .env ]; then
    echo -e "${YELLOW}No .env found — creating from .env.example...${NC}"
    cp .env.example .env
    echo -e "${GREEN}.env created. Default: Ollama (local LLM, no API key needed).${NC}"
    echo -e "Edit .env to switch to Anthropic/OpenAI/Google."
    echo ""
fi

# Source .env for port variable
set -a
source .env 2>/dev/null || true
set +a

API_PORT="${PORT:-9300}"

# ── Find container runtime ──────────────────────────────────────────────────
command_exists() { command -v "$1" >/dev/null 2>&1; }

COMPOSE_CMD=""
if command_exists "docker" && docker compose version >/dev/null 2>&1; then
    COMPOSE_CMD="docker compose"
elif command_exists "docker-compose"; then
    COMPOSE_CMD="docker-compose"
elif command_exists "podman-compose"; then
    COMPOSE_CMD="podman-compose"
fi

cleanup() {
    echo ""
    echo -e "${YELLOW}Stopping...${NC}"
    if [ -n "$COMPOSE_CMD" ]; then
        $COMPOSE_CMD --profile ollama down
    else
        podman stop nocturnusai nocturnusai-ollama 2>/dev/null
        podman rm nocturnusai nocturnusai-ollama 2>/dev/null
        podman network rm nocturnusai-net 2>/dev/null
    fi
    echo -e "${GREEN}Done.${NC}"
    exit
}

trap cleanup SIGINT SIGTERM

# ── Start ────────────────────────────────────────────────────────────────────
echo -e "${CYAN}=== NocturnusAI — Logic Server for Agentic AI ===${NC}"

if [ -n "$COMPOSE_CMD" ]; then
    echo -e "Runtime: ${GREEN}$COMPOSE_CMD${NC}"
    if [ -n "$OLLAMA_PROFILE" ]; then
        echo -e "Mode:    ${GREEN}Server + Ollama (local LLM)${NC}"
    else
        echo -e "Mode:    ${GREEN}Server only (cloud LLM)${NC}"
    fi
    echo ""

    echo "Building and starting..."
    $COMPOSE_CMD $OLLAMA_PROFILE up -d --build

    echo ""
    echo -e "${GREEN}=== NocturnusAI Running ===${NC}"
    echo -e "  API:     http://localhost:$API_PORT"
    echo -e "  Health:  http://localhost:$API_PORT/health"
    echo -e "  Docs:    http://localhost:$API_PORT/llm.txt"
    echo -e "  MCP:     http://localhost:$API_PORT/mcp"
    if [ -n "$OLLAMA_PROFILE" ]; then
        echo -e "  Ollama:  http://localhost:11434"
    fi
    echo ""
    echo -e "${CYAN}CLI:${NC} ./gradlew :nocturnusai-cli:run --args='--server http://localhost:$API_PORT --db default'"
    echo ""
    echo "Tailing logs (Ctrl+C to stop)..."
    $COMPOSE_CMD logs -f nocturnusai

else
    echo -e "${YELLOW}No docker-compose found. Using podman directly.${NC}"

    NETWORK="nocturnusai-net"
    SERVER_CONTAINER="nocturnusai"

    podman stop $SERVER_CONTAINER 2>/dev/null || true
    podman rm $SERVER_CONTAINER 2>/dev/null || true
    podman network create $NETWORK 2>/dev/null || true
    mkdir -p data

    echo "Building..."
    podman build -t nocturnusai -f Dockerfile .

    echo "Starting..."
    podman run -d --name $SERVER_CONTAINER --network $NETWORK \
        -p $API_PORT:9300 -v "$(pwd)/data:/data" \
        --env-file .env \
        nocturnusai

    echo ""
    echo -e "${GREEN}=== NocturnusAI Running ===${NC}"
    echo -e "  API:     http://localhost:$API_PORT"
    podman logs -f $SERVER_CONTAINER
fi
