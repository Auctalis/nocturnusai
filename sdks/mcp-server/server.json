{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ai.nocturnus/logic-server",
  "description": "Agent reasoning, memory, and token-optimized context for AI applications.",
  "repository": {
    "url": "https://github.com/Auctalis/nocturnusai",
    "source": "github"
  },
  "version": "0.3.11",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "nocturnusai-mcp",
      "version": "0.3.11",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Base URL of the NocturnusAI server",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "NOCTURNUSAI_URL"
        },
        {
          "description": "API key for authenticated access",
          "isRequired": false,
          "format": "string",
          "isSecret": true,
          "name": "NOCTURNUSAI_API_KEY"
        },
        {
          "description": "Database name to use",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "NOCTURNUSAI_DATABASE"
        },
        {
          "description": "Tenant ID for multi-tenant isolation",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "NOCTURNUSAI_TENANT"
        }
      ]
    }
  ]
}
