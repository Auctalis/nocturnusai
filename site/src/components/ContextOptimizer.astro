---
import { Minimize2, Zap, ArrowRight, Brain, Filter, GitMerge, TrendingDown, Shield, Layers, DollarSign } from 'lucide-astro';
---

<section id="context-optimizer" class="py-28 relative overflow-hidden">
  <!-- Background accent -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-emerald-600/8 rounded-full blur-3xl"></div>
  </div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">

    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-sm font-mono mb-6">
        <Minimize2 class="w-3.5 h-3.5" />
        Context Management Engine
      </div>
      <h2 class="text-3xl md:text-5xl font-black mb-5">
        <span class="text-white">Pay for Signal.</span><br />
        <span class="bg-clip-text text-transparent bg-gradient-to-r from-emerald-400 to-cyan-400">
          Not Noise.
        </span>
      </h2>
      <p class="text-slate-400 max-w-2xl mx-auto text-lg leading-relaxed">
        OpenAI charges $15 per million tokens. Anthropic charges $15. Google charges $10. And your agents waste 95% of every request on irrelevant context. NocturnusAI uses goal-driven backward chaining to deliver <em class="text-emerald-400 not-italic font-medium">only what your agent actually needs</em> — slashing your LLM bill by 97%.
      </p>
    </div>

    <!-- The Problem / Solution comparison -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 max-w-5xl mx-auto mb-16">
      <!-- THE PROBLEM -->
      <div class="rounded-2xl overflow-hidden bg-[#020617] border border-red-500/20 shadow-2xl">
        <div class="px-5 py-3 bg-red-500/5 border-b border-red-500/10 flex items-center justify-between">
          <span class="text-xs font-mono text-red-400">Without NocturnusAI</span>
          <span class="text-xs font-mono text-red-400/50">Every RAG pipeline</span>
        </div>
        <div class="p-6 space-y-4">
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-red-500/10 flex items-center justify-center flex-shrink-0 mt-0.5">
              <DollarSign class="w-4 h-4 text-red-400" />
            </div>
            <div>
              <div class="text-sm font-bold text-red-300 mb-1">$2.25 per request to OpenAI alone</div>
              <div class="text-xs text-slate-500">150K tokens at GPT-4o's $15/M rate — and that's before Claude or Gemini costs</div>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-red-500/10 flex items-center justify-center flex-shrink-0 mt-0.5">
              <TrendingDown class="w-4 h-4 text-red-400" />
            </div>
            <div>
              <div class="text-sm font-bold text-red-300 mb-1">$54,000/month at scale</div>
              <div class="text-xs text-slate-500">1,000 requests/hr × 24hr = token spend that grows linearly with usage</div>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-red-500/10 flex items-center justify-center flex-shrink-0 mt-0.5">
              <TrendingDown class="w-4 h-4 text-red-400" />
            </div>
            <div>
              <div class="text-sm font-bold text-red-300 mb-1">Worse accuracy, higher cost</div>
              <div class="text-xs text-slate-500">Contradictory and stale facts in context degrade LLM reasoning quality</div>
            </div>
          </div>
          <!-- Cost visualization -->
          <div class="mt-4 p-4 rounded-xl bg-red-500/5 border border-red-500/10">
            <div class="text-xs font-mono text-red-400/60 mb-2">Tokens billed per request</div>
            <div class="h-4 rounded-full bg-white/5 overflow-hidden">
              <div class="h-full rounded-full bg-gradient-to-r from-red-500 to-red-400 w-[95%] flex items-center justify-end pr-2">
                <span class="text-[9px] font-mono text-white font-bold">95% wasted spend</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- THE SOLUTION -->
      <div class="rounded-2xl overflow-hidden bg-[#020617] border border-emerald-500/20 shadow-2xl relative group">
        <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/3 to-cyan-500/3 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"></div>
        <div class="px-5 py-3 bg-emerald-500/5 border-b border-emerald-500/10 flex items-center justify-between">
          <span class="text-xs font-mono text-emerald-400">With NocturnusAI</span>
          <span class="text-xs font-mono text-emerald-400/50">Goal-driven optimization</span>
        </div>
        <div class="p-6 space-y-4">
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-emerald-500/10 flex items-center justify-center flex-shrink-0 mt-0.5">
              <DollarSign class="w-4 h-4 text-emerald-400" />
            </div>
            <div>
              <div class="text-sm font-bold text-emerald-300 mb-1">$0.01 per request</div>
              <div class="text-xs text-slate-500">820 tokens — only goal-relevant facts, ranked by salience, with full provenance</div>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-emerald-500/10 flex items-center justify-center flex-shrink-0 mt-0.5">
              <Brain class="w-4 h-4 text-emerald-400" />
            </div>
            <div>
              <div class="text-sm font-bold text-emerald-300 mb-1">Goal-driven backward chaining</div>
              <div class="text-xs text-slate-500">Tell us the question — we trace exactly which facts matter via SLD resolution</div>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-emerald-500/10 flex items-center justify-center flex-shrink-0 mt-0.5">
              <Shield class="w-4 h-4 text-emerald-400" />
            </div>
            <div>
              <div class="text-sm font-bold text-emerald-300 mb-1">Cheaper and more accurate</div>
              <div class="text-xs text-slate-500">Contradictions caught before they reach the LLM — fewer tokens, better answers</div>
            </div>
          </div>
          <!-- Efficiency visualization -->
          <div class="mt-4 p-4 rounded-xl bg-emerald-500/5 border border-emerald-500/10">
            <div class="text-xs font-mono text-emerald-400/60 mb-2">Tokens billed per request</div>
            <div class="h-4 rounded-full bg-white/5 overflow-hidden">
              <div class="h-full rounded-full bg-gradient-to-r from-emerald-500 to-cyan-400 w-[3%] min-w-[60px] flex items-center justify-end pr-2">
                <span class="text-[9px] font-mono text-white font-bold">3%</span>
              </div>
            </div>
            <div class="text-[10px] font-mono text-emerald-400/40 mt-1">97% cost reduction — every remaining token earns its keep</div>
          </div>
        </div>
      </div>
    </div>

    <!-- The Pipeline — visual flow -->
    <div class="max-w-5xl mx-auto mb-16">
      <div class="text-center mb-8">
        <h3 class="text-xl font-bold text-white mb-2">The Optimization Pipeline</h3>
        <p class="text-slate-500 text-sm">Every call to <code class="text-emerald-400 bg-emerald-500/10 px-1.5 py-0.5 rounded text-xs font-mono">POST /context</code> runs this pipeline in under 50ms</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-2xl mx-auto">
        {[
          { label: "Send Turns", sub: "Array of strings", color: "cyan" },
          { label: "Facts Ranked", sub: "Extract · dedupe · score", color: "purple" },
          { label: "Feed to LLM", sub: "GPT-4o · Claude · any", color: "emerald" },
        ].map((step, i) => (
          <div class="relative flex items-stretch">
            <div class="p-5 rounded-xl bg-white/3 border border-white/8 text-center hover:bg-white/5 hover:border-emerald-500/20 transition-all group w-full">
              <div class={`w-9 h-9 mx-auto rounded-lg flex items-center justify-center mb-3 ${
                step.color === 'cyan' ? 'bg-cyan-500/15' :
                step.color === 'purple' ? 'bg-purple-500/15' :
                'bg-emerald-500/15'
              }`}>
                <span class={`text-sm font-bold ${
                  step.color === 'cyan' ? 'text-cyan-400' :
                  step.color === 'purple' ? 'text-purple-400' :
                  'text-emerald-400'
                }`}>{String(i + 1).padStart(2, '0')}</span>
              </div>
              <div class="text-sm font-bold text-slate-200 mb-1">{step.label}</div>
              <div class="text-xs text-slate-500">{step.sub}</div>
            </div>
            {i < 2 && (
              <div class="hidden md:flex items-center absolute -right-2.5 top-1/2 -translate-y-1/2 z-10">
                <ArrowRight class="w-5 h-5 text-slate-600" />
              </div>
            )}
          </div>
        ))}
      </div>
    </div>

    <!-- Live API Example -->
    <div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Request -->
      <div class="rounded-xl overflow-hidden bg-[#020617] border border-emerald-500/20 shadow-2xl">
        <div class="flex items-center justify-between px-4 py-3 bg-emerald-500/5 border-b border-emerald-500/10">
          <span class="text-xs font-mono text-emerald-400">POST /context</span>
          <span class="text-xs font-mono text-slate-600">request</span>
        </div>
        <div class="p-5 font-mono text-sm overflow-x-auto">
<pre class="!m-0 !p-0 !bg-transparent !border-0"><code>&#123;
  <span class="text-purple-400">"turns"</span>: [
    <span class="text-green-400">"Acme Corp is on the enterprise plan."</span>,
    <span class="text-green-400">"They have a $2M contract."</span>,
    <span class="text-green-400">"24/7 SLA support included."</span>
  ]
&#125;</code></pre>
        </div>
      </div>

      <!-- Response -->
      <div class="rounded-xl overflow-hidden bg-[#020617] border border-cyan-500/20 shadow-2xl">
        <div class="flex items-center justify-between px-4 py-3 bg-cyan-500/5 border-b border-cyan-500/10">
          <span class="text-xs font-mono text-cyan-400">Ranked Facts</span>
          <span class="text-xs font-mono text-slate-600">response</span>
        </div>
        <div class="p-5 font-mono text-sm overflow-x-auto">
<pre class="!m-0 !p-0 !bg-transparent !border-0"><code>&#123;
  <span class="text-purple-400">"facts"</span>: [
    &#123; <span class="text-purple-400">"predicate"</span>: <span class="text-green-400">"customer_tier"</span>,
      <span class="text-purple-400">"args"</span>: [<span class="text-green-400">"acme_corp"</span>, <span class="text-green-400">"enterprise"</span>],
      <span class="text-purple-400">"salience"</span>: <span class="text-blue-400">0.95</span> &#125;,
    &#123; <span class="text-purple-400">"predicate"</span>: <span class="text-green-400">"contract_value"</span>,
      <span class="text-purple-400">"args"</span>: [<span class="text-green-400">"acme_corp"</span>, <span class="text-green-400">"2000000"</span>],
      <span class="text-purple-400">"salience"</span>: <span class="text-blue-400">0.92</span> &#125;,
    &#123; <span class="text-purple-400">"predicate"</span>: <span class="text-green-400">"sla_tier"</span>,
      <span class="text-purple-400">"args"</span>: [<span class="text-green-400">"acme_corp"</span>, <span class="text-green-400">"24_7"</span>],
      <span class="text-purple-400">"salience"</span>: <span class="text-blue-400">0.90</span> &#125;
  ],
  <span class="text-purple-400">"factsReturned"</span>: <span class="text-blue-400">3</span>,
  <span class="text-purple-400">"totalFactsInKB"</span>: <span class="text-blue-400">127</span>,
  <span class="text-purple-400">"contradictions"</span>: <span class="text-blue-400">0</span>
&#125;</code></pre>
        </div>
      </div>
    </div>

    <!-- Stats bar -->
    <div class="max-w-4xl mx-auto mt-12 grid grid-cols-2 md:grid-cols-4 gap-4">
      {[
        { value: "$0.01", label: "Per Optimized Request", sub: "vs $2.25 unoptimized" },
        { value: "97%", label: "Token Cost Reduction", sub: "500 → 15 facts" },
        { value: "< 50ms", label: "Pipeline Latency", sub: "Full optimization pass" },
        { value: "Diff", label: "Incremental Updates", sub: "Only bill for changes" },
      ].map(stat => (
        <div class="text-center p-5 rounded-xl bg-white/3 border border-white/8 hover:border-emerald-500/20 transition-all group">
          <div class="text-2xl md:text-3xl font-black bg-clip-text text-transparent bg-gradient-to-br from-emerald-400 to-cyan-400 mb-1">
            {stat.value}
          </div>
          <div class="text-xs font-bold text-slate-300 mb-0.5">{stat.label}</div>
          <div class="text-[10px] text-slate-600">{stat.sub}</div>
        </div>
      ))}
    </div>

    <!-- Plug and play CTA -->
    <div class="max-w-3xl mx-auto mt-12 text-center">
      <div class="p-6 rounded-2xl bg-gradient-to-r from-emerald-500/5 to-cyan-500/5 border border-emerald-500/15">
        <p class="text-slate-300 text-sm mb-4">
          <span class="font-bold text-white">Turns in, facts out, GPT-4o in.</span> Drop into any OpenAI workflow in minutes.
        </p>
        <div class="inline-block text-left rounded-lg bg-[#020617] border border-white/10 px-5 py-3 font-mono text-sm">
          <div><span class="text-slate-500"># pip install nocturnusai openai</span></div>
          <div><span class="text-blue-400">import</span> <span class="text-slate-300">requests, openai</span></div>
          <div class="mt-2"><span class="text-slate-500"># Turns in, facts out</span></div>
          <div><span class="text-slate-300">resp</span> = <span class="text-yellow-400">requests</span>.<span class="text-yellow-400">post</span>(<span class="text-green-400">"http://localhost:9300/context"</span>, json=&#123;</div>
          <div class="pl-4"><span class="text-green-400">"turns"</span>: [<span class="text-green-400">"Acme is enterprise tier"</span>, <span class="text-green-400">"They have 24/7 SLA"</span>]</div>
          <div>&#125;)</div>
          <div><span class="text-slate-300">facts</span> = <span class="text-green-400">"\n"</span>.<span class="text-yellow-400">join</span>(<span class="text-yellow-400">f</span><span class="text-green-400">"- &#123;f['predicate']&#125;(&#123;', '.join(f['args'])&#125;)"</span> <span class="text-blue-400">for</span> <span class="text-slate-300">f</span> <span class="text-blue-400">in</span> <span class="text-slate-300">resp</span>.<span class="text-yellow-400">json</span>()[<span class="text-green-400">"facts"</span>])</div>
          <div class="mt-2"><span class="text-slate-500"># Feed to GPT-4o — 200 tokens instead of 150K</span></div>
          <div><span class="text-slate-300">answer</span> = <span class="text-yellow-400">openai</span>.<span class="text-yellow-400">OpenAI</span>().<span class="text-slate-300">chat</span>.<span class="text-slate-300">completions</span>.<span class="text-yellow-400">create</span>(</div>
          <div class="pl-4"><span class="text-slate-300">model</span>=<span class="text-green-400">"gpt-4o"</span>,</div>
          <div class="pl-4"><span class="text-slate-300">messages</span>=[&#123;<span class="text-green-400">"role"</span>: <span class="text-green-400">"system"</span>, <span class="text-green-400">"content"</span>: <span class="text-yellow-400">f</span><span class="text-green-400">"Facts:\n&#123;facts&#125;"</span>&#125;,</div>
          <div class="pl-14">&#123;<span class="text-green-400">"role"</span>: <span class="text-green-400">"user"</span>, <span class="text-green-400">"content"</span>: <span class="text-green-400">"Is Acme eligible for SLA?"</span>&#125;]</div>
          <div>)</div>
          <div class="text-emerald-400 mt-1"># Correct. Sourced. $0.003 instead of $2.25 ✓</div>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .bg-white\/3 { background-color: rgba(255,255,255,0.03); }
  .border-white\/8 { border-color: rgba(255,255,255,0.08); }
  .bg-emerald-600\/8 { background-color: rgba(5,150,105,0.08); }
</style>
