---
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="site-footer">
  <div class="site-container">
    <div class="site-footer-inner">
      <div class="site-footer-copy">
        <a href={`${base}/`} class="site-logo" aria-label="Nocturnus.AI home">
          <span class="site-logo-mark" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8 4.5 6.5 1.5" />
              <path d="M16 4.5 17.5 1.5" />
              <circle cx="12" cy="12" r="9" />
              <circle cx="8.5" cy="11" r="3" />
              <circle cx="15.5" cy="11" r="3" />
              <path d="M10.5 15 12 17l1.5-2" />
            </svg>
          </span>
          <span class="site-logo-copy">
            <span class="site-logo-name">NOCTURNUS.AI</span>
            <span class="site-logo-tag">Reasoning for AI agents</span>
          </span>
        </a>
        <p>Turns bloated threads into smaller prompts before the model call.</p>
      </div>

      <div class="site-footer-links">
        <a href={`${base}/docs`}>Docs</a>
        <a href={`${base}/docs/context`}>Context Workflow</a>
        <a href={`${base}/features`}>Features</a>
        <a href={`${base}/docs/api`}>API</a>
        <a href="https://github.com/Auctalis/nocturnusai">GitHub</a>
        <a href="https://github.com/Auctalis/nocturnusai/issues">Support</a>
        <a href="mailto:dev@nocturnus.ai">Contact</a>
      </div>
    </div>

    <div class="site-footer-meta">
      <span>&copy; {year} Nocturnus.AI</span>
      <span>Lower spend. Better signal.</span>
    </div>
  </div>
</footer>
