---
const steps = [
  {
    step: "01",
    title: "Deploy the Logic Engine",
    desc: "One curl command. Requires Docker with Compose V2 already installed. The installer pulls the image, starts the server via Docker Compose, waits for healthy, and installs the native CLI binary. Nocturnus is live on port 9300 in under 30 seconds.",
    tag: "Requires Docker"
  },
  {
    step: "02",
    title: "Load Your World",
    desc: "Assert facts about your domain: customers, products, rules, state, relationships. Everything is structured, typed, and time-aware. Rules you define teach the engine what to derive. The KB grows as your world grows.",
    tag: "Hexastore + TMS"
  },
  {
    step: "03",
    title: "Connect Your Agents",
    desc: "Point any MCP-compatible framework, the Python SDK, TypeScript SDK, or direct HTTP at the running server. Your agents get 9 tools backed by the full reasoning stack — ask questions, get provable answers.",
    tag: "MCP · SDK · REST"
  }
];
---

<section id="how-it-works" class="py-24 relative overflow-hidden">
  <!-- Section Gradient Overlay -->
  <div class="absolute inset-0 bg-gradient-to-b from-[#020617] via-purple-900/10 to-[#020617] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="text-center mb-20">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-slate-400 text-sm font-mono mb-6">
        ⚡ Zero to production
      </div>
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Up and Running in 60 Seconds</h2>
      <p class="text-slate-400 max-w-xl mx-auto">No signup. No cloud dependency. No schemas to design. Production-grade infrastructure, self-hosted, on your terms.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 text-center">
      {steps.map((step, index) => (
        <div class="relative group">
          <!-- Step Circle -->
          <div class="w-20 h-20 mx-auto rounded-full bg-gradient-to-br from-cyan-500 to-purple-600 flex items-center justify-center text-2xl font-bold text-white mb-6 relative z-10 shadow-[0_0_30px_rgba(139,92,246,0.3)] group-hover:scale-110 transition-transform duration-300">
            {step.step}
          </div>

          <!-- Connector Line (Desktop Only) -->
          {index !== steps.length - 1 && (
            <div class="hidden md:block absolute top-10 left-[60%] w-full h-0.5 bg-gradient-to-r from-purple-500/50 to-transparent z-0"></div>
          )}

          <!-- Tag -->
          <div class="inline-flex px-2.5 py-0.5 rounded-full bg-white/5 border border-white/10 text-[10px] font-mono text-slate-500 mb-3">
            {step.tag}
          </div>

          <h3 class="text-xl font-bold text-white mb-3">{step.title}</h3>
          <p class="text-slate-400 text-sm max-w-xs mx-auto leading-relaxed">{step.desc}</p>
        </div>
      ))}
    </div>

    <!-- Quick-start strip -->
    <div class="mt-16 max-w-2xl mx-auto rounded-xl overflow-hidden bg-[#080e1a] border border-white/8">
      <div class="px-4 py-3 bg-white/3 border-b border-white/5 flex items-center gap-2">
        <div class="w-2.5 h-2.5 rounded-full bg-red-500/80"></div>
        <div class="w-2.5 h-2.5 rounded-full bg-yellow-500/80"></div>
        <div class="w-2.5 h-2.5 rounded-full bg-green-500/80"></div>
        <span class="ml-2 text-xs font-mono text-slate-600">bash</span>
      </div>
      <div class="p-5 font-mono text-sm space-y-2">
        <div><span class="text-cyan-500">$</span> <span class="text-slate-300">curl -fsSL https://raw.githubusercontent.com/Auctalis/nocturnusai/main/install.sh | bash</span></div>
        <div class="text-emerald-400">✓ Nocturnus live on :9300 — WAL ready · Hexastore ready · Inference ready</div>
        <div class="text-emerald-400">✓ CLI installed → nocturnusai</div>
        <div class="mt-2"><span class="text-cyan-500">$</span> <span class="text-slate-300">curl localhost:9300/health</span></div>
        <div class="text-emerald-400">&#123; "status": "ok", "ready": true &#125;</div>
      </div>
    </div>
  </div>
</section>

<style>
  .bg-white\/3 { background-color: rgba(255,255,255,0.03); }
  .border-white\/8 { border-color: rgba(255,255,255,0.08); }
</style>
