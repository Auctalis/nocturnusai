---
interface Props {
  solid?: boolean;
}

const { solid = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

type Link = { text: string; href: string; desc?: string; external?: boolean };

const productLinks: Link[] = [
  { text: 'How It Works',  href: `${base}/how-it-works`,  desc: 'The extraction → inference → delta pipeline.' },
  { text: 'Integrations',  href: `${base}/integrations`,  desc: 'LangChain, CrewAI, AutoGen, MCP, SDKs.' },
];

const proofLinks: Link[] = [
  { text: 'Benchmark',    href: `${base}/benchmark`,    desc: 'Measured on live Claude Opus 4 + Gemini 2.0 Flash.' },
  { text: 'Calculations', href: `${base}/calculations`, desc: 'Every number traced to a notebook cell.' },
];

const flatLinks: Link[] = [
  { text: 'Docs',   href: `${base}/docs` },
  { text: 'Blog',   href: `${base}/blog` },
  { text: 'About',  href: `${base}/about` },
  { text: 'GitHub', href: 'https://github.com/Auctalis/nocturnusai', external: true },
];
---

<nav id="site-nav" class={`site-nav ${solid ? 'is-solid' : ''}`}>
  <div class="site-nav-inner">
    <a href={`${base}/`} class="site-logo" aria-label="Nocturnus.AI home">
      <span class="site-logo-mark" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 4.5 6.5 1.5" />
          <path d="M16 4.5 17.5 1.5" />
          <circle cx="12" cy="12" r="9" />
          <circle cx="8.5" cy="11" r="3" />
          <circle cx="15.5" cy="11" r="3" />
          <path d="M10.5 15 12 17l1.5-2" />
        </svg>
      </span>
      <span class="site-logo-copy">
        <span class="site-logo-name">NOCTURNUS.AI</span>
        <span class="site-logo-tag">Send only what changed.</span>
      </span>
    </a>

    <div class="site-nav-links">
      <div class="nav-group" data-nav-group>
        <button class="nav-group-trigger" type="button" aria-expanded="false" aria-haspopup="true">
          Product
          <svg class="nav-chev" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div class="nav-group-panel" role="menu">
          {productLinks.map((link) => (
            <a href={link.href} role="menuitem">
              <span class="nav-item-title">{link.text}</span>
              {link.desc && <span class="nav-item-desc">{link.desc}</span>}
            </a>
          ))}
        </div>
      </div>

      <div class="nav-group" data-nav-group>
        <button class="nav-group-trigger" type="button" aria-expanded="false" aria-haspopup="true">
          Proof
          <svg class="nav-chev" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div class="nav-group-panel" role="menu">
          {proofLinks.map((link) => (
            <a href={link.href} role="menuitem">
              <span class="nav-item-title">{link.text}</span>
              {link.desc && <span class="nav-item-desc">{link.desc}</span>}
            </a>
          ))}
        </div>
      </div>

      {flatLinks.map((link) => (
        <a href={link.href} {...(link.external ? { target: '_blank', rel: 'noopener' } : {})}>{link.text}</a>
      ))}
    </div>

    <div class="site-nav-actions">
      <a href={`${base}/docs`} class="button-primary">Start Here</a>
      <button id="nav-toggle" class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="mobile-nav">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 7h16" />
          <path d="M4 12h16" />
          <path d="M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="mobile-nav">
    <div class="site-container">
      <div class="mobile-nav-section-label">Product</div>
      {productLinks.map((link) => (
        <a href={link.href} class="mobile-nav-link">{link.text}</a>
      ))}
      <div class="mobile-nav-section-label">Proof</div>
      {proofLinks.map((link) => (
        <a href={link.href} class="mobile-nav-link">{link.text}</a>
      ))}
      <div class="mobile-nav-section-label">More</div>
      {flatLinks.map((link) => (
        <a href={link.href} class="mobile-nav-link" {...(link.external ? { target: '_blank', rel: 'noopener' } : {})}>{link.text}</a>
      ))}
      <a href={`${base}/docs`} class="button-primary">Start Here</a>
    </div>
  </div>
</nav>

<style>
  .nav-group {
    position: relative;
    display: inline-flex;
  }
  .nav-group-trigger {
    background: transparent;
    border: 0;
    padding: 0;
    color: inherit;
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    line-height: 1;
  }
  .nav-group-trigger:hover { color: var(--site-text); }
  .site-nav:not(.is-solid):not(.is-scrolled) .nav-group-trigger:hover { color: var(--site-dark-text); }
  .nav-chev {
    transition: transform 180ms ease;
    opacity: 0.7;
  }
  .nav-group.is-open .nav-chev { transform: rotate(180deg); }

  .nav-group-panel {
    position: absolute;
    top: calc(100% + 0.7rem);
    left: 50%;
    min-width: 280px;
    padding: 0.5rem;
    background: #fff;
    color: var(--site-text);
    border: 1px solid var(--site-line);
    border-radius: var(--radius-md);
    box-shadow: 0 18px 48px -12px rgba(0,0,0,0.22), 0 4px 12px -2px rgba(0,0,0,0.06);
    transition: opacity 140ms ease, transform 140ms ease;
    z-index: 60;
    /* Default (closed) state. Overridden by [data-open] below. */
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%) translateY(-4px);
  }
  .nav-group.is-open .nav-group-panel {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }
  .nav-group-panel a {
    display: block;
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: inherit;
    line-height: 1.4;
  }
  .nav-group-panel a:hover {
    background: color-mix(in srgb, var(--site-accent) 10%, transparent);
    color: var(--site-text);
  }
  .nav-item-title {
    display: block;
    font-weight: 600;
    font-size: 0.88rem;
    color: var(--site-text);
  }
  .nav-item-desc {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.78rem;
    color: var(--site-muted);
  }

  .mobile-nav-section-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--site-muted-soft);
    margin: 0.9rem 0 0.3rem;
  }
  .mobile-nav-section-label:first-child { margin-top: 0; }

  @media (max-width: 980px) {
    .nav-group { display: none; }
  }
</style>

<script is:inline define:vars={{ solid }}>
  (() => {
    const nav = document.getElementById('site-nav');
    const button = document.getElementById('nav-toggle');
    const mobileNav = document.getElementById('mobile-nav');
    if (!nav) return;

    const syncScroll = () => {
      nav.classList.toggle('is-scrolled', !solid && window.scrollY > 24);
    };

    syncScroll();
    window.addEventListener('scroll', syncScroll, { passive: true });

    button?.addEventListener('click', () => {
      const open = mobileNav?.classList.toggle('is-open');
      button.setAttribute('aria-expanded', open ? 'true' : 'false');
    });

    mobileNav?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        mobileNav.classList.remove('is-open');
        button?.setAttribute('aria-expanded', 'false');
      });
    });

    // Dropdowns — hover on desktop, click to pin, Esc to close, outside click closes.
    const groups = nav.querySelectorAll('[data-nav-group]');
    let openGroup = null;

    const close = (g) => {
      g.classList.remove('is-open');
      g.querySelector('.nav-group-trigger')?.setAttribute('aria-expanded', 'false');
      if (openGroup === g) openGroup = null;
    };
    const open = (g) => {
      groups.forEach((x) => { if (x !== g) close(x); });
      g.classList.add('is-open');
      g.querySelector('.nav-group-trigger')?.setAttribute('aria-expanded', 'true');
      openGroup = g;
    };

    groups.forEach((g) => {
      const trigger = g.querySelector('.nav-group-trigger');
      let hoverTimer;

      g.addEventListener('mouseenter', () => {
        clearTimeout(hoverTimer);
        open(g);
      });
      g.addEventListener('mouseleave', () => {
        hoverTimer = setTimeout(() => close(g), 140);
      });
      trigger?.addEventListener('click', (e) => {
        e.stopPropagation();
        if (g.classList.contains('is-open')) close(g); else open(g);
      });
      trigger?.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') close(g);
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          open(g);
          g.querySelector('.nav-group-panel a')?.focus();
        }
      });
    });

    document.addEventListener('click', (e) => {
      if (openGroup && !openGroup.contains(e.target)) close(openGroup);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && openGroup) close(openGroup);
    });
  })();
</script>
