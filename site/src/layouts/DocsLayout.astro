    { title: "CLI Reference", links: [
        { text: "Installation", href: `${base}/docs/cli` },
        { text: "Connecting", href: `${base}/docs/cli#connecting` },
        { text: "Interactive REPL", href: `${base}/docs/cli#repl` },
        { text: "Knowledge", href: `${base}/docs/cli#knowledge` },
        { text: "Inspect & Export", href: `${base}/docs/cli#inspect` },
        { text: "Memory", href: `${base}/docs/cli#memory` },
