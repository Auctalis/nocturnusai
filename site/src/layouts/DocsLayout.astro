---
import Layout from './Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Nocturnus.AI documentation — build, integrate, and operate the context server for AI agents.',
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// TechArticle schema helps these pages land as rich results for
// developer-intent queries ("nocturnusai mcp", "context window api", etc.).
const techArticleLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  description,
  author: {
    '@type': 'Organization',
    name: 'Nocturnus.AI',
    url: 'https://nocturnus.ai/',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Nocturnus.AI',
    url: 'https://nocturnus.ai/',
    logo: {
      '@type': 'ImageObject',
      url: 'https://nocturnus.ai/favicon.svg',
    },
  },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};

const navItems = [
  {
    title: 'Start Here',
    links: [
      { text: 'Overview', href: `${base}/docs` },
      { text: 'Context Workflow', href: `${base}/docs/context` },
      { text: 'FAQ', href: `${base}/docs/faq` },
    ],
  },
  {
    title: 'Integrate It',
    links: [
      { text: 'API', href: `${base}/docs/api` },
      { text: 'SDKs', href: `${base}/docs/sdks` },
      { text: 'MCP', href: `${base}/docs/mcp` },
      { text: 'CLI', href: `${base}/docs/cli` },
      { text: 'Integrations', href: `${base}/docs/integrations` },
      { text: 'OpenClaw', href: `${base}/docs/openclaw` },
    ],
  },
  {
    title: 'Backend Mechanics',
    links: [
      { text: 'How It Works on the Backend', href: `${base}/docs/concepts` },
      { text: 'LLM Integration', href: `${base}/docs/llm` },
      { text: 'Multi-Tenancy', href: `${base}/docs/multi-tenancy` },
    ],
  },
  {
    title: 'Operate It',
    links: [
      { text: 'Security', href: `${base}/docs/security` },
      { text: 'Operations', href: `${base}/docs/operations` },
    ],
  },
];
---

<Layout
  title={`${title} | Nocturnus.AI Docs`}
  description={description}
  jsonLd={techArticleLd}
  bodyClass="docs-page"
>
  <Navbar solid />

  <div class="site-container docs-shell">
    <aside class="docs-sidebar">
      {navItems.map((group) => (
        <div class="docs-nav-group">
          <div class="docs-nav-title">{group.title}</div>
          <ul class="docs-nav-list">
            {group.links.map((link) => (
              <li><a href={link.href} class="docs-nav-link">{link.text}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </aside>

    <main class="docs-main">
      <details class="docs-mobile-nav">
        <summary>Docs Navigation</summary>
        <div class="docs-mobile-nav-panel">
          {navItems.map((group) => (
            <div class="docs-nav-group">
              <div class="docs-nav-title">{group.title}</div>
              <ul class="docs-nav-list">
                {group.links.map((link) => (
                  <li><a href={link.href} class="docs-nav-link">{link.text}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </details>

      <article class="docs-content">
        <slot />
      </article>
    </main>
  </div>

  <Footer />

  <script is:inline>
    (() => {
      document.querySelectorAll('.docs-content pre').forEach((pre) => {
        if (pre.querySelector('.copy-btn')) return;
        const button = document.createElement('button');
        button.className = 'copy-btn';
        button.textContent = 'copy';
        button.addEventListener('click', async () => {
          const code = pre.querySelector('code');
          const text = (code ?? pre).innerText;
          try {
            await navigator.clipboard.writeText(text);
          } catch {
            const ta = document.createElement('textarea');
            ta.value = text;
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            ta.remove();
          }
          button.textContent = 'copied';
          button.classList.add('copied');
          setTimeout(() => {
            button.textContent = 'copy';
            button.classList.remove('copied');
          }, 1600);
        });
        pre.appendChild(button);
      });
    })();
  </script>
</Layout>
