	title: string;
}

const { title } = Astro.props;

const navItems = [
    { title: "Getting Started", links: [
        { text: "Quickstart", href: "/docs" },
        { text: "Start Server", href: "/docs#install" },
        { text: "Natural Language", href: "/docs#natural-language" },
        { text: "MCP Connect", href: "/docs#mcp" },
        { text: "Direct API", href: "/docs#direct-api" },
        { text: "Build an Agent", href: "/docs#connect" },
        { text: "Troubleshooting", href: "/docs#troubleshooting" },
        { text: "From Source", href: "/docs#from-source" },
        { text: "Env Vars", href: "/docs#env-vars" },
    ]},
    { title: "MCP Integration", links: [
        { text: "What is MCP?", href: "/docs/mcp" },
        { text: "Connect in 30s", href: "/docs/mcp#quickstart" },
        { text: "Available Tools", href: "/docs/mcp#tools" },
        { text: "SSE Streaming", href: "/docs/mcp#sse" },
        { text: "Agent Discovery", href: "/docs/mcp#a2a" },
    ]},
    { title: "SDKs & Agents", links: [
        { text: "Python", href: "/docs/sdks" },
        { text: "LangChain", href: "/docs/sdks#langchain" },
        { text: "TypeScript", href: "/docs/sdks#typescript" },
    ]},
    { title: "CLI", links: [
        { text: "Installation", href: "/docs/cli" },
        { text: "Connecting", href: "/docs/cli#connecting" },
        { text: "Interactive REPL", href: "/docs/cli#repl" },
        { text: "Knowledge", href: "/docs/cli#knowledge" },
        { text: "Inspect & Export", href: "/docs/cli#inspect" },
        { text: "Memory", href: "/docs/cli#memory" },
        { text: "Admin", href: "/docs/cli#admin" },
        { text: "Auth", href: "/docs/cli#auth" },
        { text: "Scripting", href: "/docs/cli#scripting" },
        { text: "Command Reference", href: "/docs/cli#reference" },
    ]},
    { title: "Security & Auth", links: [
        { text: "Auth Modes", href: "/docs/security" },
        { text: "Bootstrap", href: "/docs/security#bootstrap" },
        { text: "API Key Management", href: "/docs/security#key-management" },
        { text: "Roles", href: "/docs/security#roles" },
        { text: "Encryption & TLS", href: "/docs/security#encryption" },
    ]},
    { title: "Multi-Tenancy", links: [
