---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Nocturnus.AI Developer Documentation" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Nocturnus.AI Docs</title>
	</head>
	<body class="bg-[#020617] text-slate-300 font-sans antialiased selection:bg-cyan-500/30 selection:text-cyan-200">
        <Navbar />
        
        <div class="max-w-[90rem] mx-auto px-6 lg:px-10 pt-28 pb-16 min-h-screen flex gap-16">
            <!-- Sidebar -->
            <aside class="w-56 hidden lg:block shrink-0 sticky top-28 h-[calc(100vh-8rem)] overflow-y-auto pr-4">
                <nav class="space-y-7">
                    {navItems.map(section => (
                        <div>
                            <h3 class="text-[0.7rem] font-bold text-slate-500 uppercase tracking-[0.12em] mb-3">{section.title}</h3>
                            <ul class="space-y-1 border-l border-white/5">
                                {section.links.map(link => (
                                    <li>
                                        <a href={link.href} class="block pl-4 py-1 text-[0.82rem] text-slate-400 hover:text-cyan-400 hover:border-l-2 hover:border-cyan-400 -ml-[1px] transition-all">
                                            {link.text}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))}
                </nav>
            </aside>

            <!-- Main Content -->
            <main class="docs-content flex-1 min-w-0 max-w-3xl">
                <slot />
            </main>

            <!-- Right spacer for symmetry -->
            <div class="w-56 hidden xl:block shrink-0"></div>
        </div>

        <Footer />

        <script>
          document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.docs-content pre').forEach(pre => {
              const btn = document.createElement('button');
              btn.className = 'copy-btn';
              btn.textContent = 'copy';
              btn.addEventListener('click', async () => {
                const code = pre.querySelector('code');
                const text = (code ?? pre).innerText;
                try {
                  await navigator.clipboard.writeText(text);
                } catch {
                  const ta = document.createElement('textarea');
                  ta.value = text;
                  document.body.appendChild(ta);
                  ta.select();
                  document.execCommand('copy');
                  ta.remove();
                }
                btn.textContent = 'copied!';
                btn.classList.add('copied');
                setTimeout(() => { btn.textContent = 'copy'; btn.classList.remove('copied'); }, 2000);
              });
              pre.appendChild(btn);
            });
          });
        </script>
	</body>
</html>
