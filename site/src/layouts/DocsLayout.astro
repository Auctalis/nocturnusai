        { text: "Scripting", href: `${base}/docs/cli#scripting` },
        { text: "API-Only Features", href: `${base}/docs/cli#api-only` },
        { text: "Command Reference", href: `${base}/docs/cli#reference` },
    ]},
    { title: "Security & Auth", links: [
        { text: "Auth Modes", href: `${base}/docs/security` },
        { text: "Bootstrap", href: `${base}/docs/security#bootstrap` },
        { text: "API Key Management", href: `${base}/docs/security#key-management` },
        { text: "Roles", href: `${base}/docs/security#roles` },
        { text: "Encryption & TLS", href: `${base}/docs/security#encryption` },
