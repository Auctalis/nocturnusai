        { text: "Using Tenants", href: "/docs/multi-tenancy#using-tenants" },
        { text: "Common Patterns", href: "/docs/multi-tenancy#patterns" },
        { text: "MCP with Tenants", href: "/docs/multi-tenancy#mcp-tenancy" },
        { text: "Scoped API Keys", href: "/docs/multi-tenancy#scoped-keys" },
    ]},
    { title: "API Reference", links: [
        { text: "Headers", href: "/docs/api" },
        { text: "Simplified API", href: "/docs/api#simplified" },
        { text: "Assert / Query", href: "/docs/api#assert-fact" },
        { text: "Transactions", href: "/docs/api#transactions" },
        { text: "Extract / Synthesize", href: "/docs/api#extract" },
        { text: "Memory", href: "/docs/api#memory" },
        { text: "Admin", href: "/docs/api#admin" },
    ]},
    { title: "LLM Integration", links: [
