        { text: "LangChain", href: `${base}/docs/sdks#langchain` },
        { text: "CrewAI", href: `${base}/docs/sdks#crewai` },
        { text: "AutoGen", href: `${base}/docs/sdks#autogen` },
        { text: "LangGraph", href: `${base}/docs/sdks#langgraph` },
