const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<DocsLayout title="Context Optimization">
    <h1>Context Optimization</h1>
    <p class="lead">
        Pass in your conversation turns. Get back relevant facts. That's it.
    </p>

    <div class="callout callout-success">
        <strong>The simplest API in the product.</strong> <code>POST /context</code> takes an array of strings (your conversation turns) and returns the facts your agent needs. No query language, no predicates to learn, no configuration required. NocturnusAI extracts, stores, and optimizes automatically — cutting your token bill by 97%.
    </div>

    <hr />

    <h2 id="the-api">The API</h2>

    <h3>Request</h3>
    <pre><code class="language-bash">curl -X POST http://localhost:9300/context \
  -H "Content-Type: application/json" \
  -H "X-Tenant-ID: default" \
  -d '&#123;
    "turns": [
      "Acme Corp is on the enterprise plan and based in Austin.",
      "They have a $2M contract with 24/7 SLA support.",
      "Their contract includes an arbitration clause."
    ]
  &#125;'</code></pre>

    <p>That's the entire request. An array of strings — one per conversation turn, document chunk, or piece of context.</p>

    <h3>Response</h3>
    <pre><code class="language-json">&#123;
  "facts": [
    &#123;
      "predicate": "customer_tier",
      "args": ["acme_corp", "enterprise"],
      "salience": 0.95,
      "provenance": null
    &#125;,
    &#123;
      "predicate": "location",
      "args": ["acme_corp", "austin"],
      "salience": 0.88,
      "provenance": null
    &#125;,
    &#123;
      "predicate": "contract_value",
      "args": ["acme_corp", "2000000"],
      "salience": 0.92,
      "provenance": null
    &#125;,
    &#123;
      "predicate": "sla_tier",
      "args": ["acme_corp", "24_7"],
      "salience": 0.90,
      "provenance": null
    &#125;,
    &#123;
      "predicate": "has_clause",
      "args": ["acme_corp", "arbitration"],
      "salience": 0.85,
      "provenance": null
    &#125;
  ],
  "totalFactsInKB": 127,
  "factsReturned": 5,
  "contradictions": 0,
  "newFactsExtracted": 5
&#125;</code></pre>

    <p>Clean, flat, simple. Each fact has a predicate, args, and a salience score. Feed these directly into your LLM's system prompt.</p>

    <div class="not-prose my-6 p-4 bg-slate-900 border-l-4 border-emerald-500 text-slate-300">
        <strong>The math:</strong> Without NocturnusAI, those 3 turns become part of a 150K-token system prompt ($2.25 at OpenAI's $15/M rate). With NocturnusAI, the 5 returned facts are ~200 tokens ($0.003). Same information, 97% cheaper.
    </div>

    <hr />

    <h2 id="with-openai">With OpenAI (GPT-4o)</h2>
    <p>The full pattern: feed your conversation turns to NocturnusAI, get back facts, pass only those facts to GPT-4o.</p>

    <pre><code class="language-python">import openai
import requests

nocturnus = "http://localhost:9300"
oai = openai.OpenAI()

# Step 1: Send conversation turns to NocturnusAI
resp = requests.post(f"&#123;nocturnus&#125;/context", json=&#123;
    "turns": [
        "Acme Corp is on the enterprise plan.",
        "They have 24/7 SLA support.",
        "Is Acme eligible for premium support?"
    ]
&#125;, headers=&#123;"X-Tenant-ID": "default"&#125;)

facts = resp.json()["facts"]

# Step 2: Build a minimal prompt from the facts
fact_lines = "\n".join(
    f"- &#123;f['predicate']&#125;(&#123;', '.join(f['args'])&#125;)"
    for f in facts
)

# Step 3: Call GPT-4o with just the relevant facts
response = oai.chat.completions.create(
    model="gpt-4o",
    messages=[
        &#123;"role": "system", "content": f"Answer based on these verified facts:\n&#123;fact_lines&#125;"&#125;,
        &#123;"role": "user", "content": "Is Acme eligible for premium support?"&#125;
    ]
)

print(response.choices[0].message.content)
# Correct answer. ~500 tokens billed instead of 150K.</code></pre>

    <hr />

    <h2 id="with-claude">With Claude (Anthropic)</h2>

    <pre><code class="language-python">import anthropic
import requests

nocturnus = "http://localhost:9300"
claude = anthropic.Anthropic()

# Get optimized facts
resp = requests.post(f"&#123;nocturnus&#125;/context", json=&#123;
    "turns": [
        "Acme Corp is on the enterprise plan.",
        "They have 24/7 SLA support."
    ]
&#125;, headers=&#123;"X-Tenant-ID": "default"&#125;)

facts = resp.json()["facts"]
fact_lines = "\n".join(f"- &#123;f['predicate']&#125;(&#123;', '.join(f['args'])&#125;)" for f in facts)

response = claude.messages.create(
    model="claude-sonnet-4-20250514",
    max_tokens=1024,
    system=f"Answer based on these verified facts:\n&#123;fact_lines&#125;",
    messages=[&#123;"role": "user", "content": "What plan is Acme on?"&#125;]
)

print(response.content[0].text)
# $0.003 instead of $2.25.</code></pre>

    <hr />

    <h2 id="python-sdk">With the Python SDK</h2>

    <pre><code class="language-python">from nocturnusai import SyncNocturnusAIClient

client = SyncNocturnusAIClient("http://localhost:9300")

# One call: turns in, facts out
result = client.post("/context", json=&#123;
    "turns": [
        "Acme Corp is on the enterprise plan.",
        "They have 24/7 SLA support.",
        "Their contract includes an arbitration clause."
    ]
&#125;)

for fact in result["facts"]:
    print(f"&#123;fact['predicate']&#125;(&#123;', '.join(fact['args'])&#125;) — salience: &#123;fact['salience']&#125;")</code></pre>

    <hr />

    <h2 id="langchain">With LangChain</h2>

    <pre><code class="language-python">from nocturnusai import SyncNocturnusAIClient
from nocturnusai.langchain import get_nocturnusai_tools
from langchain_anthropic import ChatAnthropic
from langchain.agents import AgentExecutor, create_tool_calling_agent
from langchain_core.prompts import ChatPromptTemplate

client = SyncNocturnusAIClient("http://localhost:9300")
tools = get_nocturnusai_tools(client)

llm = ChatAnthropic(model="claude-sonnet-4-20250514")
prompt = ChatPromptTemplate.from_messages([
    ("system", "You have access to a verified knowledge base. "
               "Use the context tool to get relevant facts before answering."),
    ("human", "&#123;input&#125;"),
    ("placeholder", "&#123;agent_scratchpad&#125;"),
])

agent = create_tool_calling_agent(llm, tools, prompt)
executor = AgentExecutor(agent=agent, tools=tools)

result = executor.invoke(&#123;
    "input": "Is Acme Corp eligible for premium SLA?"
&#125;)</code></pre>

    <hr />

    <h2 id="mcp">With MCP (Cursor, Claude Desktop)</h2>

    <pre><code class="language-json">// .cursor/mcp.json — that's the entire setup
&#123;
  "mcpServers": &#123;
    "nocturnus": &#123;
      "url": "http://localhost:9300/mcp/sse"
    &#125;
  &#125;
&#125;</code></pre>

    <p>Then tell your agent: <em>"Use the context tool to find relevant facts about Acme Corp, then answer my question."</em></p>

    <hr />

    <h2 id="optional">Optional Parameters</h2>
    <p>The <code>/context</code> endpoint accepts two optional fields for tuning:</p>
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="border-b border-white/10 text-white">
                    <th class="py-2">Field</th>
                    <th class="py-2">Type</th>
                    <th class="py-2">Default</th>
                    <th class="py-2">Description</th>
                </tr>
            </thead>
            <tbody class="text-slate-400">
                <tr class="border-b border-white/5">
                    <td class="py-2 font-mono text-cyan-400">turns</td>
                    <td class="py-2">string[]</td>
                    <td class="py-2">(required)</td>
                    <td class="py-2">Array of conversation turns, document chunks, or context strings</td>
                </tr>
                <tr class="border-b border-white/5">
                    <td class="py-2 font-mono text-cyan-400">maxFacts</td>
                    <td class="py-2">int?</td>
                    <td class="py-2">50</td>
                    <td class="py-2">Maximum facts to return</td>
                </tr>
                <tr class="border-b border-white/5">
                    <td class="py-2 font-mono text-cyan-400">scope</td>
                    <td class="py-2">string?</td>
                    <td class="py-2">null</td>
                    <td class="py-2">Isolate facts to a scope (e.g., a session or document ID)</td>
                </tr>
            </tbody>
        </table>
    </div>

    <hr />

    <h2 id="advanced">Need More Control?</h2>
    <p>The <code>/context</code> endpoint covers 90% of use cases. For advanced scenarios, NocturnusAI also offers:</p>
    <ul>
        <li><strong><a href={`${base}/docs/api#context-optimize`}>/context/optimize</a></strong> — goal-driven backward chaining, relevance buckets, diversity caps, contradiction control</li>
        <li><strong><a href={`${base}/docs/api#context-diff`}>/context/diff</a></strong> — incremental diffs for multi-turn conversations (only send what changed)</li>
        <li><strong><a href={`${base}/docs/api#context-ingest`}>/context/ingest</a></strong> — extract + optimize in one call with LLM context hints</li>
        <li><strong><a href={`${base}/docs/api#context-summary`}>/context/summary</a></strong> — knowledge base overview for dashboards</li>
    </ul>
    <p>See the <a href={`${base}/docs/api#context-management`}>full API reference</a> for details.</p>

