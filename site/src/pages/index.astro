    <style>
      .hero-num {
        font-variant-numeric: tabular-nums;
        display: inline-block;
      }
    </style>

    <script is:inline>
      // Fire-once count-up for the hero numbers. Runs on first paint so the
      // page feels alive from the moment it loads. Respects reduced-motion.
      (() => {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const targets = document.querySelectorAll('.hero-dark .hero-num');
        if (!targets.length) return;

        const animate = (el) => {
          const to = Number(el.dataset.countTo) || 0;
          const decimals = Number(el.dataset.countDecimals) || 0;
          const locale = el.dataset.countLocale || 'en-US';
          const fmt = (n) => n.toLocaleString(locale, {
            minimumFractionDigits: decimals,
            maximumFractionDigits: decimals,
          });

          if (reduceMotion) {
            el.textContent = fmt(to);
            return;
          }

          const duration = 900; // ms — fast enough to land before user scrolls
          const start = performance.now();
          const easeOutExpo = (t) => (t === 1 ? 1 : 1 - Math.pow(2, -10 * t));
          const tick = (now) => {
            const t = Math.min(1, (now - start) / duration);
            el.textContent = fmt(to * easeOutExpo(t));
            if (t < 1) requestAnimationFrame(tick);
            else el.textContent = fmt(to);
          };
          requestAnimationFrame(tick);
        };

        const run = () => targets.forEach(animate);
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', run, { once: true });
        } else {
          run();
        }
      })();
    </script>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- WHY NOW — the urgency and the inflection                           -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
