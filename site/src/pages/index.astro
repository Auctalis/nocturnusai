---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Pull the latest 3 published blog posts for the homepage teaser.
const latestPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const blogDateFmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

// SoftwareApplication schema — helps Google recognize Nocturnus as a
// dev tool and makes the homepage eligible for rich results.
const softwareAppLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Nocturnus.AI',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Cross-platform',
  description:
    'Open-source logic engine and context server for AI agents. Deterministic inference, truth maintenance, and salience-ranked memory — cutting prompt tokens by 82–90%, measured on live Claude Opus 4 and Gemini 2.0 Flash APIs.',
  url: 'https://nocturnus.ai/',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  softwareVersion: 'latest',
  author: {
    '@type': 'Organization',
    name: 'Nocturnus.AI',
    url: 'https://nocturnus.ai/',
  },
};

// FAQ schema stub — populate if we add an FAQ section; harmless to omit.
---

