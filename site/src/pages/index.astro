    <script is:inline>
      // Count-up for the three token cards. Fires once when the section
      // scrolls into view. Respects prefers-reduced-motion.
      (() => {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const fmt = (n, decimals) =>
          n.toLocaleString('en-US', {
            minimumFractionDigits: decimals,
            maximumFractionDigits: decimals,
          });

        const animateCounter = (el) => {
          const target = Number(el.dataset.countTo) || 0;
          const decimals = Number(el.dataset.countDecimals) || 0;
          if (reduceMotion) {
            el.textContent = fmt(target, decimals);
            return;
          }
          const duration = 1400;
          const start = performance.now();
          const easeOutExpo = (t) => (t === 1 ? 1 : 1 - Math.pow(2, -10 * t));
          const tick = (now) => {
            const t = Math.min(1, (now - start) / duration);
            el.textContent = fmt(target * easeOutExpo(t), decimals);
            if (t < 1) requestAnimationFrame(tick);
            else el.textContent = fmt(target, decimals);
          };
          requestAnimationFrame(tick);
        };

        const section = document.getElementById('token-math');
        if (!section) return;
        const counters = section.querySelectorAll('.ticker-num');
        if ('IntersectionObserver' in window && counters.length) {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  counters.forEach(animateCounter);
                  observer.disconnect();
                }
              });
            },
            { threshold: 0.25 },
          );
          observer.observe(section);
        } else {
          counters.forEach(animateCounter);
        }
      })();
    </script>

