---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="Nocturnus.AI - 97% Fewer Tokens Per Turn"
  description="Open-source context server for AI agents. Extracts, remembers, and returns only the delta — cutting prompt tokens by 97% and spend from $54K to $240/month."
>
  <Navbar />

  <main>
    <section class="hero-cut" id="top">
      <div class="hero-cut-top">
        <div class="hero-question-wrap">
          <h1 class="hero-question">Your agents replay the entire thread every call. That costs $54K/month.</h1>
        </div>
      </div>

      <div class="line-divider" aria-hidden="true"></div>

      <div class="hero-cut-bottom">
        <div class="hero-answer-wrap">
          <p class="hero-answer">Send the delta instead. $240/month.</p>
          <p class="hero-subtext">97% fewer tokens &middot; same answers &middot; first briefing in 2 minutes</p>
        </div>

        <div class="hero-footer">
          <p class="hero-support">
            NocturnusAI is an open-source context server that sits between your agent and the LLM. It extracts facts from each turn, remembers what came before, and returns only what changed &mdash; a short briefing instead of the whole thread.
          </p>
          <div class="hero-cta-row">
            <a href="#try-it" class="button-primary">Try it now</a>
            <a href={`${base}/docs`} class="button-secondary">Read the docs</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- TRY IT — two copyable curls, real output                          -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <section class="site-section" id="try-it">
      <div class="site-container">
        <div class="section-head reveal">
          <div class="site-kicker">Try It</div>
          <h2 class="site-title" style="font-size: clamp(2rem, 4vw, 3.1rem);">Two curls. See the difference.</h2>
          <p class="site-subtitle">
            Start the server, paste these, see what comes back.
          </p>
        </div>

        <!-- Start server — two paths -->
        <div class="reveal reveal-delay-1" style="margin-bottom: var(--space-5); display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3);">
          <div class="panel-dark" style="padding: var(--space-3) var(--space-4);">
            <div class="panel-label">Option A &mdash; Ollama (free, local)</div>
            <pre style="margin: 0; font-size: 0.88rem; line-height: 1.8; white-space: pre-wrap;"><span style="color: rgba(255,255,255,0.45);"># one-time: install from https://ollama.com</span>
ollama pull granite3.3:8b

<span style="color: rgba(255,255,255,0.45);"># start</span>
docker run -p 9300:9300 \
  ghcr.io/auctalis/nocturnusai:latest</pre>
          </div>
          <div class="panel-dark" style="padding: var(--space-3) var(--space-4);">
            <div class="panel-label">Option B &mdash; Cloud LLM (faster)</div>
            <pre style="margin: 0; font-size: 0.88rem; line-height: 1.8; white-space: pre-wrap;"><span style="color: rgba(255,255,255,0.45);"># pick one</span>
docker run -p 9300:9300 \
  -e ANTHROPIC_API_KEY=sk-ant-... \
  ghcr.io/auctalis/nocturnusai:latest

docker run -p 9300:9300 \
  -e OPENAI_API_KEY=sk-... \
  ghcr.io/auctalis/nocturnusai:latest</pre>
          </div>
        </div>

        <!-- Turn 1 -->
        <div class="walkthrough-step reveal reveal-delay-1">
          <div class="step-marker">
            <span class="step-number">1</span>
            <span class="step-label">Send the first turns</span>
          </div>

          <div class="panel-dark" style="padding: var(--space-4); margin-bottom: var(--space-3);">
            <div class="panel-label">Copy this</div>
            <pre style="margin: 0; font-size: 0.85rem; line-height: 1.7; white-space: pre-wrap;">curl -s -X POST http://localhost:9300/context \
  -H "Content-Type: application/json" \
  -H "X-Tenant-ID: default" \
  -d '&#123;
    "turns": [
      "User: We cannot log in after the Okta cutover.",
      "Tool crm_lookup: account=acme tier=enterprise"
    ],
    "scope": "ticket-4821",
    "sessionId": "ticket-4821"
  &#125;' | python3 -m json.tool</pre>
          </div>

          <div class="plain-card" style="border-left: 3px solid var(--site-accent);">
            <div class="section-label" style="font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--site-accent); margin-bottom: 0.8rem;">What comes back &mdash; briefingDelta</div>
            <pre style="margin: 0; font-size: 1.05rem; line-height: 1.75; white-space: pre-wrap; color: var(--site-text); font-family: var(--font-display);">## Login Issue
Login is currently failing following the Okta cutover.
Acme is on the enterprise tier.</pre>
            <p style="margin-top: 1rem; font-size: 0.9rem; color: var(--site-muted);">
              Two messy messages became two clean sentences. Put this in your system prompt.
            </p>
          </div>
        </div>

        <!-- Turn 2 -->
        <div class="walkthrough-step reveal reveal-delay-2">
          <div class="step-marker">
            <span class="step-number">2</span>
            <span class="step-label">Send the next turns &mdash; only what's new</span>
          </div>

          <div class="panel-dark" style="padding: var(--space-4); margin-bottom: var(--space-3);">
            <div class="panel-label">Copy this (same scope + sessionId)</div>
            <pre style="margin: 0; font-size: 0.85rem; line-height: 1.7; white-space: pre-wrap;">curl -s -X POST http://localhost:9300/context \
  -H "Content-Type: application/json" \
  -H "X-Tenant-ID: default" \
  -d '&#123;
    "turns": [
      "Tool auth_audit: 14 failed SAML assertions since 09:12 UTC.",
      "Tool auth_audit: issuer mismatch after IdP migration."
    ],
    "scope": "ticket-4821",
    "sessionId": "ticket-4821"
  &#125;' | python3 -m json.tool</pre>
          </div>

          <div class="plain-card" style="border-left: 3px solid var(--site-accent);">
            <div class="section-label" style="font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--site-accent); margin-bottom: 0.8rem;">briefingDelta &mdash; only what's new</div>
            <pre style="margin: 0; font-size: 1.05rem; line-height: 1.75; white-space: pre-wrap; color: var(--site-text); font-family: var(--font-display);">## SAML Assertion Failure
There were 14 failed SAML assertions starting at 09:12 UTC.
An issuer mismatch was detected following the IdP migration.</pre>
            <p style="margin-top: 1rem; font-size: 0.9rem; color: var(--site-muted);">
              Turn 1 context (login failure, enterprise tier) is <strong>not repeated</strong>. The model already has it. Only the SAML audit findings are new.
            </p>
          </div>
        </div>

        <!-- The point — token comparison -->
        <div class="walkthrough-payoff reveal reveal-delay-3">
          <div class="payoff-columns">
            <div class="payoff-left">
              <h3>What your model sees</h3>
              <div class="panel-dark" style="padding: var(--space-4);">
                <pre style="margin: 0; font-size: 1rem; line-height: 1.8; white-space: pre-wrap; font-family: var(--font-display); color: rgba(255,255,255,0.9);">14 failed SAML assertions at 09:12 UTC.
Issuer mismatch after IdP migration.</pre>
              </div>
              <p style="margin-top: 0.8rem; font-weight: 600;">~30 tokens &middot; $0.01/request</p>
            </div>
            <div class="payoff-right">
              <h3>Without Nocturnus</h3>
              <div class="equation-box" style="padding: var(--space-4); opacity: 0.55;">
                <pre style="margin: 0; font-size: 0.82rem; line-height: 1.6; white-space: pre-wrap;">User: We can't log in after the Okta cutover.
Tool crm_lookup: account=acme tier=enterprise
Tool auth_audit: 14 failed SAML assertions...
Tool auth_audit: issuer mismatch after IdP...
+ internal notes, retries, system events...</pre>
              </div>
              <p style="margin-top: 0.8rem; color: var(--site-muted);">~2,400 tokens &middot; $2.25/request</p>
            </div>
          </div>
        </div>

        <p class="reveal" style="text-align: center; margin-top: var(--space-5); font-size: 0.88rem; color: var(--site-muted-soft);">
          Runs on Ollama locally &mdash; free, no API keys needed. First calls take 10&ndash;30s on local hardware.
          <br/>Exact output phrasing varies by model. Cloud LLMs (Anthropic, OpenAI) are faster but require an API key.
        </p>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- THE NUMBERS — cost and token impact made visceral                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <section class="site-section-tight" id="numbers">
      <div class="site-container">
        <div class="section-head reveal">
          <div class="site-kicker">The Numbers</div>
          <h2 class="site-title" style="font-size: clamp(2rem, 4vw, 3.1rem);">97% fewer tokens. Same answers.</h2>
          <p class="site-subtitle">Every call that replays old context is money burned. Nocturnus sends only the delta.</p>
        </div>

        <!-- Big stat row -->
        <div class="reveal reveal-delay-1" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); margin-bottom: var(--space-6);">
          <div class="plain-card" style="text-align: center; padding: var(--space-5) var(--space-3);">
            <div style="font-size: clamp(2.5rem, 5vw, 3.5rem); font-weight: 700; font-family: var(--font-mono); color: var(--site-accent); line-height: 1;">~30</div>
            <div style="font-size: 0.85rem; color: var(--site-muted); margin-top: 0.5rem;">tokens per turn</div>
            <div style="font-size: 0.75rem; color: var(--site-muted-soft); margin-top: 0.25rem;">with Nocturnus</div>
          </div>
          <div class="plain-card" style="text-align: center; padding: var(--space-5) var(--space-3); opacity: 0.5;">
            <div style="font-size: clamp(2.5rem, 5vw, 3.5rem); font-weight: 700; font-family: var(--font-mono); line-height: 1;">~2,400</div>
            <div style="font-size: 0.85rem; color: var(--site-muted); margin-top: 0.5rem;">tokens per turn</div>
            <div style="font-size: 0.75rem; color: var(--site-muted-soft); margin-top: 0.25rem;">full replay</div>
          </div>
          <div class="plain-card" style="text-align: center; padding: var(--space-5) var(--space-3);">
            <div style="font-size: clamp(2.5rem, 5vw, 3.5rem); font-weight: 700; font-family: var(--font-mono); color: var(--site-accent); line-height: 1;">97%</div>
            <div style="font-size: 0.85rem; color: var(--site-muted); margin-top: 0.5rem;">reduction</div>
            <div style="font-size: 0.75rem; color: var(--site-muted-soft); margin-top: 0.25rem;">per request</div>
          </div>
        </div>

        <!-- Monthly cost comparison -->
        <div class="reveal reveal-delay-2" style="display: grid; grid-template-columns: 1fr auto 1fr; gap: var(--space-4); align-items: center; max-width: 700px; margin: 0 auto;">
          <div class="panel-dark" style="text-align: center; padding: var(--space-5) var(--space-4); border: 2px solid var(--site-accent);">
            <div style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 700; font-family: var(--font-mono); color: var(--site-accent);">$240</div>
            <div style="font-size: 0.85rem; color: var(--site-muted);">/month</div>
            <div style="font-size: 0.78rem; color: var(--site-muted-soft); margin-top: 0.5rem;">With Nocturnus</div>
          </div>
          <div style="font-size: 1.2rem; font-weight: 600; color: var(--site-muted-soft);">vs</div>
          <div class="panel-dark" style="text-align: center; padding: var(--space-5) var(--space-4); opacity: 0.55;">
            <div style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 700; font-family: var(--font-mono);">$54,000</div>
            <div style="font-size: 0.85rem; color: var(--site-muted);">/month</div>
            <div style="font-size: 0.78rem; color: var(--site-muted-soft); margin-top: 0.5rem;">Full replay</div>
          </div>
        </div>

        <p class="reveal reveal-delay-3" style="text-align: center; margin-top: var(--space-4); font-size: 0.82rem; color: var(--site-muted-soft);">
          At 1,000 requests/hour on GPT-4o ($15/M input tokens). Claude, Gemini, and local Ollama cost less but the ratio holds.
        </p>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- HOW IT WORKS — minimal, one sentence each                         -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <section class="site-section-tight" id="how">
      <div class="site-container">
        <div class="section-head reveal">
          <div class="site-kicker">How It Works</div>
          <h2 class="site-title" style="font-size: clamp(2rem, 4vw, 3rem);">One call per turn. The server handles the rest.</h2>
        </div>

        <div class="feature-grid reveal reveal-delay-1">
          <div class="plain-card">
            <h3>Extracts</h3>
            <p>The LLM pulls structured facts from your raw turns and stores them under the conversation scope.</p>
          </div>
          <div class="plain-card">
            <h3>Remembers</h3>
            <p>Prior turns are fed back automatically so references like "the account" resolve correctly across turns.</p>
          </div>
          <div class="plain-card">
            <h3>Returns the delta</h3>
            <p>Each call returns <code>briefingDelta</code> &mdash; a short natural-language summary of only what's new since the last turn.</p>
          </div>
        </div>

        <div class="fits-comparison reveal reveal-delay-2">
          <div class="panel-dark" style="padding: var(--space-4);">
            <div class="panel-label">Your code</div>
            <pre style="margin: 0; font-size: 0.88rem; line-height: 1.8; white-space: pre-wrap;"><span style="color: rgba(255,255,255,0.5);">// Each turn — one call</span>
r = POST /context(turns, scope, sessionId)

<span style="color: rgba(255,255,255,0.5);">// Feed the delta to your model</span>
messages = [
  system(r.briefingDelta),
  user(next_question),
]

<span style="color: rgba(255,255,255,0.5);">// Done with the conversation? Clean up.</span>
DELETE /scope/ticket-4821</pre>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- WHERE IT FITS — architecture diagram                              -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <section class="site-section-tight" id="fits">
      <div class="site-container">
        <div class="section-head reveal">
          <div class="site-kicker">Where It Fits</div>
          <h2 class="site-title" style="font-size: clamp(2rem, 4vw, 3rem);">One server between your agent and the model.</h2>
        </div>

        <div class="reveal reveal-delay-1" style="max-width: 700px; margin: 0 auto;">
          <div class="panel-dark" style="padding: var(--space-5) var(--space-4); text-align: center;">
            <pre style="margin: 0; font-size: clamp(0.82rem, 1.5vw, 1rem); line-height: 2.2; white-space: pre-wrap; font-family: var(--font-mono); color: rgba(255,255,255,0.88);">Your Agent Code       NocturnusAI         LLM API
<span style="color: var(--site-muted-soft);">  (turns)</span>     <span style="color: var(--site-accent);">&rarr;</span>    <span style="color: var(--site-muted-soft);">(extract, store,</span>   <span style="color: var(--site-accent);">&rarr;</span>   <span style="color: var(--site-muted-soft);">(receives only</span>
                       <span style="color: var(--site-muted-soft);"> diff, rank)</span>          <span style="color: var(--site-muted-soft);">the delta)</span></pre>
          </div>
          <p style="text-align: center; margin-top: var(--space-3); font-size: 0.85rem; color: var(--site-muted-soft);">
            Self-hosted. Open source. Not a memory store &mdash; a prompt compression server.
            <br/>
            <a href="https://github.com/Auctalis/nocturnusai" style="color: var(--site-accent); text-decoration: none;">
              <img src="https://img.shields.io/github/stars/Auctalis/nocturnusai?style=flat&amp;color=f59e0b" alt="GitHub stars" style="vertical-align: middle; margin-right: 0.3rem; height: 20px;" />
              Star on GitHub
            </a>
          </p>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- SDK QUICKSTART — copyable code                                    -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <section class="site-section-tight" id="sdks">
      <div class="site-container">
        <div class="section-head reveal">
          <div class="site-kicker">SDKs</div>
          <h2 class="site-title" style="font-size: clamp(2rem, 4vw, 3rem);">Or use Python / TypeScript.</h2>
        </div>

        <div class="sdk-tabs reveal reveal-delay-1">
          <div class="panel-dark" style="padding: var(--space-4); flex: 1;">
            <div class="panel-label">pip install nocturnusai</div>
            <pre style="margin: 0; font-size: 0.85rem; line-height: 1.7; white-space: pre-wrap;">from nocturnusai import SyncNocturnusAIClient

c = SyncNocturnusAIClient("http://localhost:9300")

r = c.process_turns(
    turns=["User: Can't log in after Okta cutover."],
    scope="ticket-4821",
    session_id="ticket-4821",
)
print(r.briefing_delta)
<span style="color: rgba(255,255,255,0.5);"># "Login is currently failing following the
#  Okta cutover. Acme is enterprise tier."</span></pre>
          </div>
          <div class="panel-dark" style="padding: var(--space-4); flex: 1;">
            <div class="panel-label">npm install nocturnusai-sdk</div>
            <pre style="margin: 0; font-size: 0.85rem; line-height: 1.7; white-space: pre-wrap;">import &#123; NocturnusAIClient &#125; from 'nocturnusai-sdk';

const c = new NocturnusAIClient(&#123;
  baseUrl: 'http://localhost:9300',
&#125;);

const r = await c.processTurns(&#123;
  turns: ["User: Can't log in after Okta cutover."],
  scope: 'ticket-4821',
  sessionId: 'ticket-4821',
&#125;);
console.log(r.briefingDelta);</pre>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- CTA                                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <section class="site-section cta-band" id="get-started">
      <div class="site-container">
        <div class="section-head reveal">
          <h2 class="site-title" style="font-size: clamp(2rem, 4vw, 3rem); color: var(--site-dark-text);">Start here.</h2>
        </div>

        <div class="statement-grid reveal reveal-delay-1">
          <div class="plain-card" style="background: rgba(255,255,255,0.04); border-color: rgba(255,255,255,0.12); box-shadow: none;">
            <h3 style="color: var(--site-dark-text);">Docs</h3>
            <p style="color: rgba(255,255,255,0.72);">Full context workflow, API reference, SDKs, MCP, CLI.</p>
            <div class="button-row" style="margin-top: 1rem;">
              <a href={`${base}/docs`} class="button-primary">Open the docs</a>
            </div>
          </div>

          <div class="plain-card" style="background: rgba(255,255,255,0.04); border-color: rgba(255,255,255,0.12); box-shadow: none;">
            <h3 style="color: var(--site-dark-text);">Features</h3>
            <p style="color: rgba(255,255,255,0.72);">Memory lifecycle, three-layer model, goal-driven context, scope management.</p>
            <div class="button-row" style="margin-top: 1rem;">
              <a href={`${base}/features`} class="button-secondary">See features</a>
            </div>
          </div>

          <div class="plain-card" style="background: rgba(255,255,255,0.04); border-color: rgba(255,255,255,0.12); box-shadow: none;">
            <h3 style="color: var(--site-dark-text);">GitHub</h3>
            <p style="color: rgba(255,255,255,0.72);">Source, issues, Docker images, native binaries.</p>
            <div class="button-row" style="margin-top: 1rem;">
              <a href="https://github.com/Auctalis/nocturnusai" class="button-secondary">View on GitHub</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
